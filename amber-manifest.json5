{
  manifest_version: "0.1.0",

  config_schema: {
    type: "object",
    properties: {
      openai_api_key: { type: "string", secret: true },
      sqlsmith_openai_model: { type: "string" },
    },
    required: [],
    additionalProperties: false,
  },

  slots: {},

  program: {
    image: "ghcr.io/desalzes/amadeus-sqlsmith:latest",
    entrypoint: "uv run python src/server.py --host 0.0.0.0 --port 9009",

    env: {
      OPENAI_API_KEY: "${config.openai_api_key}",
      SQLSMITH_OPENAI_MODEL: "${config.sqlsmith_openai_model}",
    },

    network: {
      endpoints: [
        { name: "a2a_endpoint", port: 9009 },
      ],
    },
  },

  provides: {
    a2a: { kind: "a2a", endpoint: "a2a_endpoint" },
  },

  exports: { a2a: "a2a" },
}
